# Copy to .env for local overrides. Never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fleetos
SPRING_DATASOURCE_USERNAME=fleetos
SPRING_DATASOURCE_PASSWORD=fleetos
# Long random string in production. The app refuses nothing in dev, but the
# default in application.yml is a placeholder and must be replaced when deployed.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
PORT=8080
# Phase 3 (optional — both have defaults in application.yml):
# Where binary proof uploads are stored on disk (default: backend/uploads).
UPLOADS_DIR=backend/uploads
# WebPush/VAPID keys — needed only to go live with real push delivery.
# Until set, the push channel is a stub that logs and never fakes delivery.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
